        "500": "#a986a7",
        "600": "#8f7492",
        "700": "#76627e",
        "800": "#5d5069",
        "900": "#433e54"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
