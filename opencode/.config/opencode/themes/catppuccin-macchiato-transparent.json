{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["blue", "purple", "green", "orange", "pink", "cyan", "red"],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.200",
      "faint": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.500",
          "$focused": "$hue.neutral.900",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$hue.neutral.500"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.500",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.yellow.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.cyan.200"
        }
      }
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.700"
    },
    "scrollbar": {
      "base": "$hue.neutral.500"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.orange.200"
      },
      "background": {
        "added": "#29342b",
        "removed": "#3a2a31",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "$hue.neutral.600",
        "background": {
          "added": "#223025",
          "removed": "#2f242b"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.purple.200",
      "function": "$hue.blue.200",
      "variable": "$hue.red.200",
      "string": "$hue.green.200",
      "number": "$hue.orange.200",
      "type": "$hue.yellow.200",
      "operator": "$hue.sky.200",
      "punctuation": "$hue.neutral.100"
    },
    "markdown": {
      "text": "$hue.neutral.100",
      "heading": "$hue.purple.200",
      "link": "$hue.blue.200",
      "linkText": "$hue.sky.200",
      "code": "$hue.green.200",
      "blockQuote": "$hue.yellow.200",
      "emphasis": "$hue.yellow.200",
      "strong": "$hue.orange.200",
      "horizontalRule": "$hue.neutral.300",
      "listItem": "$hue.blue.200",
      "listEnumeration": "$hue.sky.200",
      "image": "$hue.blue.200",
      "imageText": "$hue.sky.200",
      "codeBlock": "$hue.neutral.100"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#cad3f5",
        "200": "#b8c0e0",
        "300": "#a5adcb",
        "400": "#939ab7",
        "500": "#6e738d",
        "600": "#494d64",
        "700": "#363a4f",
        "800": "#1e2030",
        "900": "#181926"
      },
      "red": {
