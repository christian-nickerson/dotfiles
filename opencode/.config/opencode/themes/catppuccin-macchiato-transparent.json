        "900": "#344153"
      },
      "blue": {
        "100": "#adc6f7",
        "200": "#8aadf4",
        "300": "#7e9ddd",
        "400": "#718cc7",
        "500": "#657cb0",
        "600": "#586c9a",
        "700": "#4c5c83",
        "800": "#404b6c",
        "900": "#333b56"
