        "800": "#5d4a4d",
        "900": "#433a44"
      },
      "yellow": {
        "100": "#f3e1bc",
        "200": "#eed49f",
        "300": "#d5bf93",
        "400": "#bdaa86",
        "500": "#a4957a",
        "600": "#8c806e",
        "700": "#736b62",
        "800": "#5b5655",
        "900": "#424149"
      },
      "green": {
        "100": "#c1e5b5",
        "200": "#a6da95",
        "300": "#96c48a",
        "400": "#86af7f",
        "500": "#779974",
        "600": "#678369",
        "700": "#576d5e",
        "800": "#475853",
        "900": "#384248"
      },
      "cyan": {
        "100": "#aee2da",
        "200": "#8bd5ca",
        "300": "#7ec0b9",
        "400": "#72aba7",
        "500": "#659696",
        "600": "#598084",
        "700": "#4c6b73",
        "800": "#405661",
        "900": "#334150"
      },
      "sky": {
        "100": "#b2e3eb",
        "200": "#91d7e3",
        "300": "#84c2ce",
        "400": "#77acba",
        "500": "#6997a5",
        "600": "#5c8291",
        "700": "#4f6c7c",
